<mxfile host="app.diagrams.net" modified="2026-11-13T00:00:00.000Z" agent="Wintap Ecosystem Wiki" version="24.7.17" type="device">
  <diagram id="dbt-shared-access" name="1 • DBT shared access">
    <mxGraphModel dx="2040" dy="1490" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="1490" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="DBT shared access • request → durable grant → local build → release" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="35" y="22" width="1960" height="48" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="PROPOSED • S3 carries messages; the scheduled coordinator alone grants access. DuckDB on the compaction server is the authoritative ledger." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="35" y="76" width="1960" height="35" as="geometry"/></mxCell>
        <mxCell id="request-phase" value="1   REQUEST AND GRANT • coordinator is OPEN; no compaction is due" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fillColor=#eef2ff;strokeColor=none;fontColor=#334155;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="225" width="1960" height="40" as="geometry"/></mxCell>
        <mxCell id="build-phase" value="2   LOCAL BUILD AND RELEASE • shared access spans source preflight, all build reads and child shutdown" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fillColor=#edf7ed;strokeColor=none;fontColor=#24542a;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="800" width="1960" height="40" as="geometry"/></mxCell>

        <mxCell id="client" value="&lt;b&gt;DBT wrapper&lt;/b&gt;&lt;br&gt;User's local machine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#548b50;fontColor=#24542a;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="55" y="135" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="mailbox" value="&lt;b&gt;S3 coordination&lt;/b&gt;&lt;br&gt;Per-job JSON messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#49336b;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="375" y="135" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="tick" value="&lt;b&gt;Coordinator tick&lt;/b&gt;&lt;br&gt;Cron • every minute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c49a28;fontColor=#644c0c;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="715" y="135" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="ledger" value="&lt;b&gt;DuckDB ledger&lt;/b&gt;&lt;br&gt;Compaction server disk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4c78a8;fontColor=#173b65;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="1035" y="135" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="dbt" value="&lt;b&gt;DBT child process&lt;/b&gt;&lt;br&gt;User's local machine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#548b50;fontColor=#24542a;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="1355" y="135" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="data" value="&lt;b&gt;S3 data + checkpoints&lt;/b&gt;&lt;br&gt;Raw / compacted / entities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#49336b;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="1695" y="135" width="270" height="70" as="geometry"/></mxCell>

        <mxCell id="life-client" style="endArrow=none;dashed=1;strokeColor=#9aa8b8;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="205" as="sourcePoint"/><mxPoint x="190" y="1340" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="life-mailbox" style="endArrow=none;dashed=1;strokeColor=#9aa8b8;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="205" as="sourcePoint"/><mxPoint x="510" y="1340" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="life-tick" style="endArrow=none;dashed=1;strokeColor=#9aa8b8;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="205" as="sourcePoint"/><mxPoint x="850" y="1340" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="life-ledger" style="endArrow=none;dashed=1;strokeColor=#9aa8b8;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="205" as="sourcePoint"/><mxPoint x="1170" y="1340" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="life-dbt" style="endArrow=none;dashed=1;strokeColor=#9aa8b8;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1490" y="205" as="sourcePoint"/><mxPoint x="1490" y="1340" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="life-data" style="endArrow=none;dashed=1;strokeColor=#9aa8b8;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1830" y="205" as="sourcePoint"/><mxPoint x="1830" y="1340" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="active-client" value="" style="fillColor=#edf7ed;strokeColor=#548b50;" vertex="1" parent="1"><mxGeometry x="184" y="290" width="12" height="835" as="geometry"/></mxCell>
        <mxCell id="active-tick-grant" value="" style="fillColor=#fff2cc;strokeColor=#c49a28;" vertex="1" parent="1"><mxGeometry x="844" y="365" width="12" height="280" as="geometry"/></mxCell>
        <mxCell id="active-tick-release" value="" style="fillColor=#fff2cc;strokeColor=#c49a28;" vertex="1" parent="1"><mxGeometry x="844" y="1190" width="12" height="125" as="geometry"/></mxCell>
        <mxCell id="active-ledger-grant" value="" style="fillColor=#dae8fc;strokeColor=#4c78a8;" vertex="1" parent="1"><mxGeometry x="1164" y="495" width="12" height="60" as="geometry"/></mxCell>
        <mxCell id="active-ledger-release" value="" style="fillColor=#dae8fc;strokeColor=#4c78a8;" vertex="1" parent="1"><mxGeometry x="1164" y="1250" width="12" height="55" as="geometry"/></mxCell>
        <mxCell id="active-dbt" value="" style="fillColor=#d5e8d4;strokeColor=#548b50;" vertex="1" parent="1"><mxGeometry x="1484" y="865" width="12" height="190" as="geometry"/></mxCell>

        <mxCell id="m1" value="PUT request • new job UUID" style="endArrow=block;html=1;strokeColor=#548b50;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="196" y="300" as="sourcePoint"/><mxPoint x="510" y="300" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="LIST / GET pending requests" style="endArrow=block;html=1;strokeColor=#c49a28;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="844" y="365" as="sourcePoint"/><mxPoint x="510" y="365" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3" value="Validated request" style="endArrow=open;dashed=1;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="425" as="sourcePoint"/><mxPoint x="844" y="425" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4" value="TX: reserve reader + grant outbox" style="endArrow=block;html=1;strokeColor=#4c78a8;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="856" y="495" as="sourcePoint"/><mxPoint x="1164" y="495" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5" value="COMMIT • reader now counts" style="endArrow=open;dashed=1;html=1;strokeColor=#4c78a8;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1164" y="555" as="sourcePoint"/><mxPoint x="856" y="555" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6" value="PUT immutable grant" style="endArrow=block;html=1;strokeColor=#c49a28;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="844" y="630" as="sourcePoint"/><mxPoint x="510" y="630" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="durability-note" value="&lt;b&gt;Crash-safe ordering&lt;/b&gt;&lt;br&gt;An undelivered grant still reserves a reader.&lt;br&gt;Lost PUT acknowledgment → retry the same grant." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4ff;strokeColor=#4c78a8;fontColor=#173b65;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="930" y="655" width="540" height="100" as="geometry"/></mxCell>
        <mxCell id="m7" value="Poll own grant key" style="endArrow=block;html=1;strokeColor=#548b50;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="196" y="695" as="sourcePoint"/><mxPoint x="510" y="695" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m8" value="Grant bound to this request + dataset" style="endArrow=open;dashed=1;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="750" as="sourcePoint"/><mxPoint x="196" y="750" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m9" value="Start source preflight → dbt build under this grant" style="endArrow=block;html=1;strokeColor=#548b50;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="196" y="865" as="sourcePoint"/><mxPoint x="1484" y="865" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m10" value="Events (+ optional entity inputs)" style="endArrow=block;html=1;strokeColor=#548b50;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1496" y="925" as="sourcePoint"/><mxPoint x="1830" y="925" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="local-output-note" value="&lt;b&gt;Analysis output stays local&lt;/b&gt;&lt;br&gt;User's DuckDB database + DBT artifacts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf7ed;strokeColor=#548b50;fontColor=#24542a;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1390" y="960" width="480" height="65" as="geometry"/></mxCell>
        <mxCell id="m11" value="Return result only after all source-reading children stop" style="endArrow=open;dashed=1;html=1;strokeColor=#548b50;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1484" y="1055" as="sourcePoint"/><mxPoint x="196" y="1055" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m12" value="PUT release • grant UUID" style="endArrow=block;html=1;strokeColor=#548b50;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="196" y="1125" as="sourcePoint"/><mxPoint x="510" y="1125" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m13" value="Next tick: ingest release" style="endArrow=block;html=1;strokeColor=#c49a28;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="844" y="1190" as="sourcePoint"/><mxPoint x="510" y="1190" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m14" value="TX: retire reservation + audit" style="endArrow=block;html=1;strokeColor=#4c78a8;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="856" y="1250" as="sourcePoint"/><mxPoint x="1164" y="1250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m15" value="COMMIT • terminal record retained" style="endArrow=open;dashed=1;html=1;strokeColor=#4c78a8;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1164" y="1305" as="sourcePoint"/><mxPoint x="856" y="1305" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="footer" value="&lt;b&gt;Shared reader contract&lt;/b&gt; • Several granted DBT jobs may run together. All unreleased grants exclude compaction, even before delivery.&lt;br&gt;Coordinator: Python + local DuckDB, one cron invocation at a time. Clients: Python wrapper, existing S3 access, ten-second polling proposed.&lt;br&gt;Stopped/lost client: retain its reservation until release or explicit recovery. No automatic grant expiry. Companion: design.md." style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#334155;fontSize=15;spacing=14;" vertex="1" parent="1"><mxGeometry x="35" y="1360" width="1960" height="95" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hourly-writer-handoff" name="2 • Hourly writer handoff">
    <mxGraphModel dx="2040" dy="1790" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="1790" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Hourly writer handoff • close admission → drain readers → compact → reopen" style="text;html=1;align=left;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="35" y="22" width="1960" height="48" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="PROPOSED • Reader A already holds a grant. Reader B arrives while compaction is due. Example: hour 11:00–12:00 UTC becomes eligible at 12:10." style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="35" y="76" width="1960" height="35" as="geometry"/></mxCell>
        <mxCell id="drain-phase" value="1   DRAINING • once a writer is due, no new read grants are issued" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fillColor=#fff8e6;strokeColor=none;fontColor=#644c0c;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="225" width="1960" height="40" as="geometry"/></mxCell>
        <mxCell id="write-phase" value="2   WRITING • zero reserved readers; one exclusive writer for the selected closed UTC hour" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fillColor=#fff2cc;strokeColor=none;fontColor=#644c0c;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="755" width="1960" height="40" as="geometry"/></mxCell>
        <mxCell id="open-phase" value="3   OPEN • after successful migration and once the backlog is caught up" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=16;fillColor=#edf7ed;strokeColor=none;fontColor=#24542a;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="35" y="1310" width="1960" height="40" as="geometry"/></mxCell>

        <mxCell id="clients" value="&lt;b&gt;Local DBT wrappers&lt;/b&gt;&lt;br&gt;A active • B waiting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#548b50;fontColor=#24542a;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="55" y="135" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="mailbox" value="&lt;b&gt;S3 coordination&lt;/b&gt;&lt;br&gt;Per-job JSON messages" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#49336b;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="375" y="135" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="tick" value="&lt;b&gt;Coordinator tick&lt;/b&gt;&lt;br&gt;Cron • every minute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c49a28;fontColor=#644c0c;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="715" y="135" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="ledger" value="&lt;b&gt;DuckDB ledger&lt;/b&gt;&lt;br&gt;Readers + cursor + writer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4c78a8;fontColor=#173b65;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="1035" y="135" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="compactor" value="&lt;b&gt;Compactor CLI&lt;/b&gt;&lt;br&gt;Isolated locked runtime" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#644c0c;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="1355" y="135" width="270" height="70" as="geometry"/></mxCell>
        <mxCell id="data" value="&lt;b&gt;S3 data + checkpoints&lt;/b&gt;&lt;br&gt;Raw / compacted / entities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#49336b;fontSize=17;spacing=10;" vertex="1" parent="1"><mxGeometry x="1695" y="135" width="270" height="70" as="geometry"/></mxCell>

        <mxCell id="life-clients" style="endArrow=none;dashed=1;strokeColor=#9aa8b8;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="205" as="sourcePoint"/><mxPoint x="190" y="1620" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="life-mailbox" style="endArrow=none;dashed=1;strokeColor=#9aa8b8;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="205" as="sourcePoint"/><mxPoint x="510" y="1620" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="life-tick" style="endArrow=none;dashed=1;strokeColor=#9aa8b8;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="850" y="205" as="sourcePoint"/><mxPoint x="850" y="1620" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="life-ledger" style="endArrow=none;dashed=1;strokeColor=#9aa8b8;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="205" as="sourcePoint"/><mxPoint x="1170" y="1620" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="life-compactor" style="endArrow=none;dashed=1;strokeColor=#9aa8b8;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1490" y="205" as="sourcePoint"/><mxPoint x="1490" y="1620" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="life-data" style="endArrow=none;dashed=1;strokeColor=#9aa8b8;strokeWidth=1.5;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1830" y="205" as="sourcePoint"/><mxPoint x="1830" y="1620" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="active-tick-drain" value="" style="fillColor=#fff2cc;strokeColor=#c49a28;" vertex="1" parent="1"><mxGeometry x="844" y="305" width="12" height="75" as="geometry"/></mxCell>
        <mxCell id="active-tick-write" value="" style="fillColor=#fff2cc;strokeColor=#c49a28;" vertex="1" parent="1"><mxGeometry x="844" y="575" width="12" height="940" as="geometry"/></mxCell>
        <mxCell id="active-compactor" value="" style="fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="1484" y="945" width="12" height="200" as="geometry"/></mxCell>

        <mxCell id="m1" value="COMMIT DRAINING • hour due" style="endArrow=block;html=1;strokeColor=#4c78a8;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="856" y="305" as="sourcePoint"/><mxPoint x="1170" y="305" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="A still reserved • do not launch" style="endArrow=open;dashed=1;html=1;strokeColor=#4c78a8;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="365" as="sourcePoint"/><mxPoint x="856" y="365" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3" value="B: PUT request; wait for grant" style="endArrow=block;html=1;strokeColor=#548b50;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="430" as="sourcePoint"/><mxPoint x="510" y="430" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="drain-note" value="&lt;b&gt;The tick exits while A runs&lt;/b&gt;&lt;br&gt;Later cron ticks keep admission closed.&lt;br&gt;B cannot start from an absent writer marker or status.json." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#c49a28;fontColor=#644c0c;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="720" y="405" width="610" height="90" as="geometry"/></mxCell>
        <mxCell id="m4" value="A: PUT release after children stop" style="endArrow=block;html=1;strokeColor=#548b50;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="190" y="515" as="sourcePoint"/><mxPoint x="510" y="515" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5" value="Next tick: ingest release + request" style="endArrow=block;html=1;strokeColor=#c49a28;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="844" y="575" as="sourcePoint"/><mxPoint x="510" y="575" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6" value="TX: release A; keep B waiting" style="endArrow=block;html=1;strokeColor=#4c78a8;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="856" y="640" as="sourcePoint"/><mxPoint x="1170" y="640" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m7" value="COMMIT • zero reserved readers" style="endArrow=open;dashed=1;html=1;strokeColor=#4c78a8;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="705" as="sourcePoint"/><mxPoint x="856" y="705" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="m8" value="TX: WRITING + durable run ID" style="endArrow=block;html=1;strokeColor=#4c78a8;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="856" y="825" as="sourcePoint"/><mxPoint x="1170" y="825" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m9" value="COMMIT • launch permitted" style="endArrow=open;dashed=1;html=1;strokeColor=#4c78a8;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="885" as="sourcePoint"/><mxPoint x="856" y="885" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m10" value="Run one eligible hour • explicit roots and limits" style="endArrow=block;html=1;strokeColor=#c49a28;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="856" y="945" as="sourcePoint"/><mxPoint x="1484" y="945" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m11" value="Entities → raw → checkpoints" style="endArrow=block;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1496" y="1005" as="sourcePoint"/><mxPoint x="1830" y="1005" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="exclusive-note" value="&lt;b&gt;One local process lock spans this tick and writer&lt;/b&gt;&lt;br&gt;Overlapping cron ticks exit as busy.&lt;br&gt;Restart with unresolved WRITING → BLOCKED, even if the old child survives." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#c49a28;fontColor=#644c0c;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="675" y="1025" width="675" height="85" as="geometry"/></mxCell>
        <mxCell id="entity-note" value="Entity mode: verify final checkpoints&lt;br&gt;before ending this exclusive interval." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5edf8;strokeColor=#9673a6;fontColor=#49336b;fontSize=14;spacing=8;" vertex="1" parent="1"><mxGeometry x="1420" y="1045" width="500" height="60" as="geometry"/></mxCell>
        <mxCell id="m12" value="Verified migration + checkpoints; child exit" style="endArrow=open;dashed=1;html=1;strokeColor=#d79b00;strokeWidth=2;fontSize=15;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1484" y="1145" as="sourcePoint"/><mxPoint x="856" y="1145" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m13" value="TX: complete hour; advance cursor" style="endArrow=block;html=1;strokeColor=#4c78a8;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="856" y="1205" as="sourcePoint"/><mxPoint x="1170" y="1205" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m14" value="COMMIT OPEN • caught up" style="endArrow=open;dashed=1;html=1;strokeColor=#4c78a8;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="1265" as="sourcePoint"/><mxPoint x="856" y="1265" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="m15" value="TX: reserve B + grant outbox" style="endArrow=block;html=1;strokeColor=#4c78a8;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="856" y="1380" as="sourcePoint"/><mxPoint x="1170" y="1380" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m16" value="COMMIT • B now reserved" style="endArrow=open;dashed=1;html=1;strokeColor=#4c78a8;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1170" y="1440" as="sourcePoint"/><mxPoint x="856" y="1440" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m17" value="PUT B's immutable grant" style="endArrow=block;html=1;strokeColor=#c49a28;strokeWidth=2;fontSize=14;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="844" y="1500" as="sourcePoint"/><mxPoint x="510" y="1500" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m18" value="B polls: own grant received → start" style="endArrow=open;dashed=1;html=1;strokeColor=#9673a6;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="510" y="1570" as="sourcePoint"/><mxPoint x="190" y="1570" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="footer" value="&lt;b&gt;Other outcomes&lt;/b&gt; • Backlog remains → stay DRAINING and process the next eligible hour on a later tick.&lt;br&gt;Failure, incomplete deletion or uncertain writer completion → BLOCKED; retain cursor and evidence until reconciliation.&lt;br&gt;A stopped writer alone does not prove raw/compacted data is ready. The local ledger survives normal cron/host restarts. Companion: design.md." style="rounded=1;whiteSpace=wrap;html=1;align=left;fillColor=#fff1f0;strokeColor=#d79b94;fontColor=#6b2825;fontSize=15;spacing=14;" vertex="1" parent="1"><mxGeometry x="35" y="1650" width="1960" height="105" as="geometry"/></mxCell>
