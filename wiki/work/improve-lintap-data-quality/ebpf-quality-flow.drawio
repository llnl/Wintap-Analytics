        <mxCell id="shutdownBand" value="COORDINATED SHUTDOWN — producers before ETL, durable completion before logger close" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;align=left;spacingLeft=10" vertex="1" parent="s1"><mxGeometry x="30" y="800" width="1390" height="30" as="geometry"/></mxCell>
        <mxCell id="S13" value="[S13] flush pending attribution retries" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11" edge="1" parent="s1"><mxGeometry relative="1" as="geometry"><mxPoint x="92" y="855" as="sourcePoint"/><mxPoint x="712" y="855" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="S14" value="[S14] stop producers; join poll before native free" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontSize=11" edge="1" parent="s1"><mxGeometry relative="1" as="geometry"><mxPoint x="92" y="895" as="sourcePoint"/><mxPoint x="557" y="895" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="S15" value="[S15] complete + fully drain sender queue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#6c8ebf;fontSize=11" edge="1" parent="s1"><mxGeometry relative="1" as="geometry"><mxPoint x="557" y="935" as="sourcePoint"/><mxPoint x="557" y="975" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="S16" value="[S16] stop schedules; drain serializer queue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11" edge="1" parent="s1"><mxGeometry relative="1" as="geometry"><mxPoint x="92" y="995" as="sourcePoint"/><mxPoint x="1027" y="995" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="S17" value="[S17] wait: backlog=0, failures=0, drops=0" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11" edge="1" parent="s1"><mxGeometry relative="1" as="geometry"><mxPoint x="1192" y="1035" as="sourcePoint"/><mxPoint x="1027" y="1035" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="S18" value="[S18] stop cache worker; final cross-stream merge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontSize=11" edge="1" parent="s1"><mxGeometry relative="1" as="geometry"><mxPoint x="92" y="1075" as="sourcePoint"/><mxPoint x="1357" y="1075" as="targetPoint"/></mxGeometry></mxCell>

        <mxCell id="seqNote" value="&lt;b&gt;How to cite this page:&lt;/b&gt; “Dedicated FileSerializer draining” = [S9–S10]. “Coordinated serializer/parquet/cache shutdown” = [S16–S18]. “Native shutdown race” = [S14–S15]. “Adaptive delivery latency” = [S2–S3]." style="shape=note;whiteSpace=wrap;html=1;size=15;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12" vertex="1" parent="s1"><mxGeometry x="280" y="1125" width="980" height="65" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
