        <mxCell id="uploader" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot;&gt;UPLOADER&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Configured adapter&lt;br&gt;Eligible files only&lt;br&gt;&lt;b&gt;Preserve relative paths&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=3;fontFamily=Helvetica;fontSize=22;fontColor=#9A3412;spacing=16;" vertex="1" parent="1"><mxGeometry x="80" y="1015" width="275" height="180" as="geometry"/></mxCell>
        <mxCell id="raw-s3" value="&lt;b&gt;&lt;font style=&quot;font-size:26px&quot;&gt;RAW EVENT STORE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Optional S3 delivery&lt;br&gt;Same raw_sensor layout&lt;br&gt;&lt;b&gt;DBT can read directly&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=18;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=3;fontFamily=Helvetica;fontSize=22;fontColor=#173B65;spacing=16;" vertex="1" parent="1"><mxGeometry x="450" y="1015" width="285" height="180" as="geometry"/></mxCell>
        <mxCell id="upload-note" value="&lt;b&gt;Delivery behavior&lt;/b&gt;&lt;br&gt;Failed uploads: retain local files for retry.&lt;br&gt;Successful uploads: local deletion may be enabled." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#9A3412;spacing=6;" vertex="1" parent="1"><mxGeometry x="80" y="1230" width="650" height="100" as="geometry"/></mxCell>
        <mxCell id="compactor" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot;&gt;MANUAL COMPACTOR&lt;/font&gt;&lt;/b&gt;&lt;br&gt;PyUtil · closed UTC hours&lt;br&gt;Merge files; preserve rows / fields&lt;br&gt;Validate schemas + row totals&lt;br&gt;&lt;br&gt;&lt;b&gt;Retain source by default&lt;/b&gt;&lt;br&gt;Delete only by explicit option" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontFamily=Helvetica;fontSize=22;fontColor=#92400E;spacing=14;" vertex="1" parent="1"><mxGeometry x="825" y="975" width="400" height="205" as="geometry"/></mxCell>
        <mxCell id="compacted-store" value="&lt;b&gt;&lt;font style=&quot;font-size:26px&quot;&gt;COMPACTED EVENT STORE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;compacted/&amp;lt;event&amp;gt;/…&lt;br&gt;Hourly merged event Parquet" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=16;fillColor=#CCFBF1;strokeColor=#0F766E;strokeWidth=3;fontFamily=Helvetica;fontSize=22;fontColor=#134E4A;spacing=14;" vertex="1" parent="1"><mxGeometry x="825" y="1230" width="400" height="120" as="geometry"/></mxCell>

        <mxCell id="entity-phase" value="&lt;b&gt;&lt;font style=&quot;font-size:28px&quot;&gt;ENTITY PHASE · OPT-IN&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read raw + compacted process evidence&lt;br&gt;Update complete per-host snapshots&lt;br&gt;&lt;b&gt;Publish + verify before raw processing&lt;/b&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontFamily=Helvetica;fontSize=22;fontColor=#5B21B6;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="975" width="470" height="165" as="geometry"/></mxCell>
        <mxCell id="combined-order" value="&lt;b&gt;COMBINED MODE ORDER&lt;/b&gt;&lt;br&gt;Verified entities → raw processing&lt;br&gt;→ checkpoint publication&lt;br&gt;&lt;br&gt;&lt;b&gt;Entity failure blocks raw deletion.&lt;/b&gt;" style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontColor=#5B21B6;spacing=6;" vertex="1" parent="1"><mxGeometry x="1890" y="980" width="510" height="160" as="geometry"/></mxCell>
        <mxCell id="entity-store" value="&lt;b&gt;&lt;font style=&quot;font-size:24px&quot;&gt;PROCESS ENTITY SNAPSHOT STORE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;One complete Parquet snapshot per host&lt;br&gt;Long-lived + exited process context&lt;br&gt;&lt;b&gt;Separate root; not in-window events&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=16;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=3;fontFamily=Helvetica;fontSize=22;fontColor=#5B21B6;spacing=14;" vertex="1" parent="1"><mxGeometry x="1320" y="1170" width="470" height="185" as="geometry"/></mxCell>
        <mxCell id="checkpoint-store" value="&lt;b&gt;&lt;font style=&quot;font-size:26px&quot;&gt;PROCESSING CHECKPOINT STORE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Separate hourly coverage + receipt lineage&lt;br&gt;&lt;b&gt;Entity-mode DBT preflight input&lt;/b&gt;&lt;br&gt;Missing process-hour coverage blocks build" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=16;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=3;fontFamily=Helvetica;fontSize=22;fontColor=#5B21B6;spacing=14;" vertex="1" parent="1"><mxGeometry x="1890" y="1170" width="510" height="185" as="geometry"/></mxCell>

        <mxCell id="optional-upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=15;strokeColor=#EA580C;strokeWidth=6;dashed=1;dashPattern=3 2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="raw-local" target="uploader"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="595" y="610"/><mxPoint x="790" y="610"/><mxPoint x="790" y="860"/><mxPoint x="217.5" y="860"/></Array></mxGeometry></mxCell>
        <mxCell id="uploader-s3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=15;strokeColor=#EA580C;strokeWidth=6;dashed=1;dashPattern=3 2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="uploader" target="raw-s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s3-compactor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=15;strokeColor=#D97706;strokeWidth=6;dashed=1;dashPattern=3 2;exitX=1;exitY=0.5;entryX=0;entryY=0.63;" edge="1" parent="1" source="raw-s3" target="compactor"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="compact-output" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=14;strokeColor=#D97706;strokeWidth=6;dashed=1;dashPattern=3 2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="compactor" target="compacted-store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="compacted-ingest" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=15;strokeColor=#0F766E;strokeWidth=6;dashed=1;dashPattern=3 2;exitX=1;exitY=0.5;entryX=0.88;entryY=1;" edge="1" parent="1" source="compacted-store" target="input-gate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1270" y="1290"/><mxPoint x="1270" y="610"/><mxPoint x="1205.6" y="610"/></Array></mxGeometry></mxCell>
        <mxCell id="compacted-return-label" value="Optional compacted input ↑" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#0F766E;labelBackgroundColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="870" y="808" width="395" height="40" as="geometry"/></mxCell>
        <mxCell id="entity-publish" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=14;strokeColor=#7C3AED;strokeWidth=5;dashed=1;dashPattern=3 2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="entity-phase" target="entity-store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="entity-enrichment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=15;strokeColor=#7C3AED;strokeWidth=5;dashed=1;dashPattern=3 2;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="entity-store" target="silver"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1830" y="1262.5"/><mxPoint x="1830" y="610"/><mxPoint x="1627.5" y="610"/></Array></mxGeometry></mxCell>
        <mxCell id="enrichment-label" value="Optional durable context ↑" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=24;fontStyle=1;fontColor=#7C3AED;" vertex="1" parent="1"><mxGeometry x="1400" y="808" width="415" height="40" as="geometry"/></mxCell>
        <mxCell id="checkpoint-publication" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endSize=14;strokeColor=#7C3AED;strokeWidth=5;dashed=1;dashPattern=3 2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="combined-order" target="checkpoint-store"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="event-layout" value="EVENT PARTITIONS · &amp;lt;event&amp;gt;/dayPK=YYYYMMDD/hourPK=HH[/protoPK=…]/*.parquet · raw_sensor and compacted preserve this layout" style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="70" y="1390" width="2340" height="46" as="geometry"/></mxCell>
        <mxCell id="operations-panel" style="rounded=1;arcSize=6;html=1;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="1460" width="2380" height="215" as="geometry"/></mxCell>
        <mxCell id="overlap-heading" value="NO SILENT OVERLAP MASKING" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontStyle=1;fontColor=#FBBF24;" vertex="1" parent="1"><mxGeometry x="85" y="1478" width="690" height="43" as="geometry"/></mxCell>
        <mxCell id="overlap-body" value="&lt;b&gt;Both raw + compacted copies present = both count.&lt;/b&gt;&lt;br&gt;Reconcile / remove the migrated raw prefix; rebuild DBT.&lt;br&gt;Existing destination hours skip, even partial output:&lt;br&gt;manual reconciliation is required." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=24;fontColor=#F8FAFC;spacing=4;" vertex="1" parent="1"><mxGeometry x="85" y="1532" width="715" height="124" as="geometry"/></mxCell>
        <mxCell id="qa-heading" value="BOUNDED QA ≠ COMPLETENESS" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontStyle=1;fontColor=#7DD3FC;" vertex="1" parent="1"><mxGeometry x="855" y="1478" width="710" height="43" as="geometry"/></mxCell>
        <mxCell id="qa-body" value="Schema probes · &lt;b&gt;dbt-test&lt;/b&gt; · &lt;b&gt;qa-pid-hash&lt;/b&gt;.&lt;br&gt;No all-file / all-row preflight integrity scan.&lt;br&gt;Selected partitions do not prove gap-free collection.&lt;br&gt;Checkpoints ≠ complete ancestry / migration proof." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=24;fontColor=#F8FAFC;spacing=4;" vertex="1" parent="1"><mxGeometry x="855" y="1532" width="705" height="124" as="geometry"/></mxCell>
        <mxCell id="safety-heading" value="EXPLICIT OPERATING BOUNDARIES" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontStyle=1;fontColor=#C4B5FD;" vertex="1" parent="1"><mxGeometry x="1620" y="1478" width="760" height="43" as="geometry"/></mxCell>
        <mxCell id="safety-body" value="One writer; exclude DBT readers during updates.&lt;br&gt;Final checkpoint failure may follow raw deletion.&lt;br&gt;Production scheduling / bootstrap / cutover deferred.&lt;br&gt;Raw-backed views still require input access." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=24;fontColor=#F8FAFC;spacing=4;" vertex="1" parent="1"><mxGeometry x="1620" y="1532" width="750" height="124" as="geometry"/></mxCell>
        <mxCell id="source-caption" value="Source and full storage layouts: wiki/workflow/wintap-etl-data-flow.md · Presentation companion · Updated 2026-11-14" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=22;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="70" y="1695" width="2330" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
