        <mxCell id="entity-heading" value="C / DURABLE PROCESS CONTEXT" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=26;fontStyle=1;fontColor=#6D28D9;" vertex="1" parent="1"><mxGeometry x="1320" y="907" width="480" height="46" as="geometry"/></mxCell>
