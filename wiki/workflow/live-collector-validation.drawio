<mxfile host="app.diagrams.net" modified="2026-10-30T00:00:00.000Z" agent="Wintap Ecosystem Wiki" version="24.7.17" type="device">
  <diagram id="live-collector-data-flow" name="1 — Data and evidence">
    <mxGraphModel dx="1800" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1120" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Live-collector validation" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1600" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Known activity → the deployed collection path → delivered-data checks • One-shot smoke runs and recurring telemetry canaries" style="text;html=1;align=left;fontSize=16;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="1690" height="35" as="geometry"/></mxCell>
        <mxCell id="host" value="LINUX COLLECTION HOST" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#e8eef6;swimlaneFillColor=#f8fafc;strokeColor=#a8b8cc;fontColor=#172b4d;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="130" width="970" height="780" as="geometry"/></mxCell>
        <mxCell id="remote" value="S3 / GARAGE" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#ede9f6;swimlaneFillColor=#faf9fd;strokeColor=#b4a6cc;fontColor=#49336b;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1040" y="130" width="320" height="780" as="geometry"/></mxCell>
        <mxCell id="analysis" value="ANALYSIS MACHINE" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#e8eef6;swimlaneFillColor=#f8fafc;strokeColor=#a8b8cc;fontColor=#172b4d;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1400" y="130" width="370" height="780" as="geometry"/></mxCell>
        <mxCell id="L1" value="&lt;b&gt;[L1] Login-user setup&lt;/b&gt;&lt;br&gt;uv venv → persistent Python&lt;br&gt;Install DuckDB 1.5.6&lt;br&gt;Keep venv/bin/python" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172b4d;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="L2" value="&lt;b&gt;[L2] Root-run stimulus&lt;/b&gt;&lt;br&gt;telemetry_smoke_workload.py&lt;br&gt;or periodic canary runner&lt;br&gt;Explicit local data root" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c49a28;fontColor=#644c0c;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="370" y="210" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="L3" value="&lt;b&gt;[L3] Local QA artifacts&lt;/b&gt;&lt;br&gt;Fresh --output + --manifest&lt;br&gt;Outside data/runtime roots&lt;br&gt;and configured file filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172b4d;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="690" y="210" width="280" height="110" as="geometry"/></mxCell>
        <mxCell id="L4" value="&lt;b&gt;[L4] Known OS activity&lt;/b&gt;&lt;br&gt;Process + thread lifecycle&lt;br&gt;File operations • IPv4 TCP/UDP&lt;br&gt;Optional native clone helper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4c78a8;fontColor=#173b65;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="260" height="115" as="geometry"/></mxCell>
        <mxCell id="L5" value="&lt;b&gt;[L5] Running Lintap collector&lt;/b&gt;&lt;br&gt;eBPF → attribution → ETL&lt;br&gt;Normal aggregation, flush&lt;br&gt;and merge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4c78a8;fontColor=#173b65;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="370" y="410" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="L6" value="&lt;b&gt;[L6] Collected telemetry&lt;/b&gt;&lt;br&gt;DATA_ROOT/raw_sensor/&lt;br&gt;Process / file / network parquet&lt;br&gt;HOST startup context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4c78a8;fontColor=#173b65;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="690" y="410" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="L7" value="&lt;b&gt;[L7] Smoke evidence publisher&lt;/b&gt;&lt;br&gt;smoke_manifest + smoke_parquet&lt;br&gt;Run UUID, selectors, outcomes&lt;br&gt;Start / selectors / final snapshots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#548b50;fontColor=#24542a;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="370" y="610" width="270" height="115" as="geometry"/></mxCell>
        <mxCell id="L8" value="&lt;b&gt;[L8] Expected-activity evidence&lt;/b&gt;&lt;br&gt;DATA_ROOT/raw_sensor/&lt;br&gt;&lt;b&gt;raw_smoke_test/&lt;/b&gt;&lt;br&gt;dayPK=YYYYMMDD/hourPK=HH" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#548b50;fontColor=#24542a;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="690" y="610" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="L9" value="&lt;b&gt;[L9] Existing collector uploader&lt;/b&gt;&lt;br&gt;Sweeps finalized raw_sensor parquet&lt;br&gt;Uses deployed S3 configuration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#49336b;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="690" y="795" width="280" height="90" as="geometry"/></mxCell>
        <mxCell id="host-note" value="&lt;b&gt;The collector stays running.&lt;/b&gt;&lt;br&gt;The stimulus and its evidence publisher&lt;br&gt;run separately from the service." style="text;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#475569;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="775" width="560" height="105" as="geometry"/></mxCell>
        <mxCell id="remote-note" value="&lt;b&gt;One configured dataset&lt;/b&gt;&lt;br&gt;Evidence and telemetry travel&lt;br&gt;through the same uploader." style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=15;fontColor=#49336b;spacing=8;" vertex="1" parent="1"><mxGeometry x="1060" y="210" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="L10" value="&lt;b&gt;[L10] Delivered raw_sensor/&lt;/b&gt;&lt;br&gt;&lt;br&gt;Collected telemetry parquet&lt;br&gt;+ HOST capability receipts&lt;br&gt;&lt;br&gt;&lt;b&gt;raw_smoke_test/&lt;/b&gt;&lt;br&gt;Portable manifest snapshots&lt;br&gt;&lt;br&gt;Latest valid revision per run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9f6;strokeColor=#9673a6;fontColor=#49336b;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="1070" y="410" width="260" height="280" as="geometry"/></mxCell>
        <mxCell id="remote-latency" value="Normal upload latency&lt;br&gt;UTC publication partitions&lt;br&gt;&lt;br&gt;Uploaded local files may be deleted;&lt;br&gt;check arrival in the destination." style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#645575;spacing=8;" vertex="1" parent="1"><mxGeometry x="1060" y="750" width="280" height="130" as="geometry"/></mxCell>
        <mxCell id="L11" value="&lt;b&gt;[L11] Discover runs&lt;/b&gt;&lt;br&gt;Refresh S3 files / results&lt;br&gt;Read raw_smoke_test manifests&lt;br&gt;Select host + run" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#548b50;fontColor=#24542a;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="1430" y="210" width="310" height="115" as="geometry"/></mxCell>
        <mxCell id="L12" value="&lt;b&gt;[L12] Explicit validation&lt;/b&gt;&lt;br&gt;Canary Tests → Validate selected run&lt;br&gt;&lt;br&gt;DuckDB reads matching S3 telemetry&lt;br&gt;Compare activities, identities,&lt;br&gt;paths and endpoints to selectors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4c78a8;fontColor=#173b65;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="1430" y="455" width="310" height="155" as="geometry"/></mxCell>
        <mxCell id="L13" value="&lt;b&gt;[L13] Scoped observations&lt;/b&gt;&lt;br&gt;Observed / missing / skipped&lt;br&gt;Identity or endpoint violations&lt;br&gt;&lt;br&gt;Inspect the individual checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c49a28;fontColor=#644c0c;fontSize=15;spacing=10;" vertex="1" parent="1"><mxGeometry x="1430" y="710" width="310" height="135" as="geometry"/></mxCell>
        <mxCell id="e12" value="sudo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;dashed=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="L1" target="L2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;dashed=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="L2" target="L3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e24" value="generate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4c78a8;strokeWidth=2;fontSize=13;labelBackgroundColor=#f8fafc;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L2" target="L4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="438" y="360"/><mxPoint x="190" y="360"/></Array></mxGeometry></mxCell>
        <mxCell id="e45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4c78a8;strokeWidth=2;" edge="1" parent="1" source="L4" target="L5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4c78a8;strokeWidth=2;" edge="1" parent="1" source="L5" target="L6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e27" value="record expected activity" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#548b50;strokeWidth=2;fontSize=13;labelBackgroundColor=#f8fafc;exitX=0.9;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L2" target="L7"><mxGeometry x="0.5" relative="1" as="geometry"><Array as="points"><mxPoint x="613" y="350"/><mxPoint x="660" y="350"/><mxPoint x="660" y="565"/><mxPoint x="505" y="565"/></Array></mxGeometry></mxCell>
        <mxCell id="e78" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#548b50;strokeWidth=2;" edge="1" parent="1" source="L7" target="L8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e89" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#548b50;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="L8" target="L9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e69" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4c78a8;strokeWidth=2;exitX=1;exitY=0.5;entryX=1;entryY=0.25;" edge="1" parent="1" source="L6" target="L9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="985" y="468"/><mxPoint x="985" y="818"/></Array></mxGeometry></mxCell>
        <mxCell id="e910" value="upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=3;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;entryX=0;entryY=0.75;" edge="1" parent="1" source="L9" target="L10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1020" y="863"/><mxPoint x="1020" y="620"/></Array></mxGeometry></mxCell>
        <mxCell id="e1011" value="manifests" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#548b50;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.15;entryX=0;entryY=0.5;" edge="1" parent="1" source="L10" target="L11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="452"/><mxPoint x="1380" y="268"/></Array></mxGeometry></mxCell>
        <mxCell id="e1112" value="explicit click" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;dashed=1;strokeWidth=2;fontSize=13;labelBackgroundColor=#f8fafc;" edge="1" parent="1" source="L11" target="L12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e1012" value="telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4c78a8;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;entryX=0;entryY=0.5;" edge="1" parent="1" source="L10" target="L12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1370" y="578"/><mxPoint x="1370" y="533"/></Array></mxGeometry></mxCell>
        <mxCell id="e1213" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4c78a8;strokeWidth=2;" edge="1" parent="1" source="L12" target="L13"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legend" value="&lt;b&gt;FLOW KEY&lt;/b&gt;   Blue: activity / collected telemetry     Green: expected-activity evidence     Purple: shared delivery     Dashed gray: operator / local-artifact handoff" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="925" width="1710" height="30" as="geometry"/></mxCell>
        <mxCell id="checkpoint" value="&lt;b&gt;Four separate checkpoints&lt;/b&gt;&lt;br&gt;Generated → published locally → delivered to S3 → validated&lt;br&gt;Each step needs its own evidence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#334155;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="975" width="555" height="100" as="geometry"/></mxCell>
        <mxCell id="selectors" value="&lt;b&gt;Match by recorded selectors&lt;/b&gt;&lt;br&gt;Hostname + UTC window + PID/TID + paths / ports&lt;br&gt;The run UUID groups manifests; raw events have no smoke UUID." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#334155;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="610" y="975" width="565" height="100" as="geometry"/></mxCell>
        <mxCell id="limits" value="&lt;b&gt;Interpret the scope&lt;/b&gt;&lt;br&gt;Workload success and S3 arrival do not establish capture.&lt;br&gt;Missing, skipped and ambiguous observations remain visible." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#644c0c;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="1200" y="975" width="570" height="100" as="geometry"/></mxCell>
        <mxCell id="footer" value="Wintap Ecosystem • Source anchors and commands: wiki/workflow/live-collector-validation.md • Reviewed 2026-10-30" style="text;html=1;align=left;fontSize=12;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="1087" width="1700" height="25" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="live-collector-operator-flow" name="2 — Operator workflow">
    <mxGraphModel dx="1800" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1120" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Live-collector validation • operator workflow" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1700" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Root-owned field systems • Prepare dependencies as the login user; execute the workload with the persistent venv interpreter through sudo." style="text;html=1;align=left;fontSize=16;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="1700" height="35" as="geometry"/></mxCell>
        <mxCell id="prepare" value="PREPARE ON THE LINUX HOST" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#e8eef6;swimlaneFillColor=#f8fafc;strokeColor=#a8b8cc;fontColor=#172b4d;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="540" height="745" as="geometry"/></mxCell>
        <mxCell id="generate" value="GENERATE AND DELIVER" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#e7f0e5;swimlaneFillColor=#f8fbf7;strokeColor=#9bb597;fontColor=#24542a;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="140" width="540" height="745" as="geometry"/></mxCell>
        <mxCell id="validate" value="VALIDATE ON THE ANALYSIS MACHINE" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#ede9f6;swimlaneFillColor=#faf9fd;strokeColor=#b4a6cc;fontColor=#49336b;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1220" y="140" width="540" height="745" as="geometry"/></mxCell>
        <mxCell id="P1" value="&lt;b&gt;[P1] Confirm readiness and paths&lt;/b&gt;&lt;br&gt;Collector running; sensor startup complete&lt;br&gt;Read the resolved DATA_ROOT&lt;br&gt;Default: /var/log/lintap/data (contains raw_sensor)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172b4d;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="210" width="480" height="120" as="geometry"/></mxCell>
        <mxCell id="P2" value="&lt;b&gt;[P2] Create a persistent venv • one-time setup&lt;/b&gt;&lt;br&gt;&lt;br&gt;VENV=$HOME/.local/share/wintap-smoke/venv&lt;br&gt;uv venv --no-project --python 3.11 &amp;quot;$VENV&amp;quot;&lt;br&gt;uv pip install --python &amp;quot;$VENV/bin/python&amp;quot;&lt;br&gt;duckdb==1.5.6&lt;br&gt;&lt;br&gt;Keep this environment for later runs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172b4d;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="390" width="480" height="190" as="geometry"/></mxCell>
        <mxCell id="P3" value="&lt;b&gt;[P3] Check the interpreter through sudo&lt;/b&gt;&lt;br&gt;PYTHON=$VENV/bin/python&lt;br&gt;Import DuckDB using sudo &amp;quot;$PYTHON&amp;quot;&lt;br&gt;Expect UID 0 and DuckDB 1.5.6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c49a28;fontColor=#644c0c;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="650" width="480" height="120" as="geometry"/></mxCell>
        <mxCell id="P4" value="&lt;b&gt;[P4] Generate one fresh named workload&lt;/b&gt;&lt;br&gt;&lt;br&gt;sudo &amp;quot;$PYTHON&amp;quot; telemetry_smoke_workload.py&lt;br&gt;--output &amp;lt;fresh external QA directory&amp;gt;&lt;br&gt;--manifest &amp;lt;fresh portable JSON path&amp;gt;&lt;br&gt;--smoke-data-root &amp;quot;$DATA_ROOT&amp;quot;&lt;br&gt;&lt;br&gt;Run from Wintap/devtools or use the full script path." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c49a28;fontColor=#644c0c;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="660" y="210" width="480" height="190" as="geometry"/></mxCell>
        <mxCell id="P5" value="&lt;b&gt;[P5] Check local publication&lt;/b&gt;&lt;br&gt;generated … = OS workload completed&lt;br&gt;Smoke parquet: … = evidence published locally&lt;br&gt;Smoke manifest: … = JSON backup retained&lt;br&gt;&lt;br&gt;Export warnings matter even when exit code is 0." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#548b50;fontColor=#24542a;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="660" y="465" width="480" height="150" as="geometry"/></mxCell>
        <mxCell id="P6" value="&lt;b&gt;[P6] Allow normal delivery&lt;/b&gt;&lt;br&gt;Collector flush / merge / upload cycles continue&lt;br&gt;raw_smoke_test travels alongside telemetry&lt;br&gt;Confirm arrival at the configured S3 destination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#49336b;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="660" y="690" width="480" height="120" as="geometry"/></mxCell>
        <mxCell id="P7" value="&lt;b&gt;[P7] Configure, launch and discover&lt;/b&gt;&lt;br&gt;SmokeTests setup: see dashboard guide&lt;br&gt;JSON config + AWS profile → localhost:8501&lt;br&gt;UTC days → Refresh files / results → host/run&lt;br&gt;raw_smoke_test provides the manifest automatically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#548b50;fontColor=#24542a;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1250" y="210" width="480" height="150" as="geometry"/></mxCell>
        <mxCell id="P8" value="&lt;b&gt;[P8] Request the telemetry checks&lt;/b&gt;&lt;br&gt;Canary Tests → telemetry-workload family&lt;br&gt;Choose the exact host / time / run UUID&lt;br&gt;&lt;b&gt;Validate selected run&lt;/b&gt;&lt;br&gt;For expanded canary rounds: Run all validations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4c78a8;fontColor=#173b65;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1250" y="430" width="480" height="150" as="geometry"/></mxCell>
        <mxCell id="P9" value="&lt;b&gt;[P9] Review scoped evidence&lt;/b&gt;&lt;br&gt;Expected activities versus matching telemetry&lt;br&gt;Process identities, exact file paths and socket endpoints&lt;br&gt;Investigate missing / skipped / contradictory observations&lt;br&gt;&lt;br&gt;Stimulus-only runs can remain yellow with useful matches." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c49a28;fontColor=#644c0c;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1250" y="650" width="480" height="160" as="geometry"/></mxCell>
        <mxCell id="p12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="P1" target="P2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="P2" target="P3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p34" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="P3" target="P4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="710"/><mxPoint x="605" y="305"/></Array></mxGeometry></mxCell>
        <mxCell id="p45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#548b50;strokeWidth=2;" edge="1" parent="1" source="P4" target="P5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p56" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=2;" edge="1" parent="1" source="P5" target="P6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p67" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="P6" target="P7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1195" y="750"/><mxPoint x="1195" y="285"/></Array></mxGeometry></mxCell>
        <mxCell id="p78" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#548b50;strokeWidth=2;" edge="1" parent="1" source="P7" target="P8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p89" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4c78a8;strokeWidth=2;" edge="1" parent="1" source="P8" target="P9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="C1" value="&lt;b&gt;[C1] One-shot smoke run&lt;/b&gt;&lt;br&gt;Use telemetry_smoke_workload.py for a small process/file/network run.&lt;br&gt;Add --clone-helper for optional native clone families.&lt;br&gt;Choose a fresh output directory and manifest each time." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#334155;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="925" width="840" height="140" as="geometry"/></mxCell>
        <mxCell id="C2" value="&lt;b&gt;[C2] Recurring telemetry canaries&lt;/b&gt;&lt;br&gt;Reuse the persistent Python with run-smoke-soak.sh --python …&lt;br&gt;Start with --rounds 1; five families share a canaryRoundId.&lt;br&gt;After pilot review, repeat in a persistent terminal; Ctrl-C stops the runner." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#334155;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="910" y="925" width="850" height="140" as="geometry"/></mxCell>
        <mxCell id="footer" value="Copy-paste commands: wiki/tool/named-telemetry-smoke-workload.md • Persistent venv required; a temporary uv run --with interpreter may disappear before sudo." style="text;html=1;align=left;fontSize=13;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="1085" width="1720" height="25" as="geometry"/></mxCell>
      </root>
