<mxfile host="app.diagrams.net" modified="2026-11-13T00:00:00.000Z" agent="Wintap Ecosystem Wiki" version="24.7.17" type="device">
  <diagram id="wintap-etl-data-flow" name="Sensors → compaction → DBT history">
    <mxGraphModel dx="2150" dy="1320" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2150" pageHeight="1320" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Wintap / Lintap telemetry → compaction → complete retained DBT event history" style="text;html=1;align=left;verticalAlign=middle;fontSize=29;fontStyle=1;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="30" y="22" width="2070" height="48" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Raw events stay in S3 under raw_sensor; hourly compaction writes a sibling /compacted prefix; PyUtil reads both with name-aligned UNION ALL. Long-lived process entities use a separate, optional durable snapshot store." style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="30" y="76" width="2070" height="42" as="geometry"/></mxCell>

        <mxCell id="hosts" value="COLLECTION HOSTS • LOCAL DISK" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#e8eef6;swimlaneFillColor=#f8fafc;strokeColor=#a8b8cc;fontColor=#172b4d;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="25" y="140" width="260" height="660" as="geometry"/></mxCell>
        <mxCell id="raw-store-lane" value="S3 • RAW EVENT INPUT" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#ede9f6;swimlaneFillColor=#faf9fd;strokeColor=#b4a6cc;fontColor=#49336b;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="140" width="280" height="660" as="geometry"/></mxCell>
        <mxCell id="compaction-lane" value="WINTAP-PYUTIL • HOURLY COMPACTION" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#fff8e6;swimlaneFillColor=#fffdf6;strokeColor=#d6b656;fontColor=#644c0c;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="590" y="140" width="410" height="660" as="geometry"/></mxCell>
        <mxCell id="derived-store-lane" value="S3 • SEPARATE OUTPUT ROOTS" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#ede9f6;swimlaneFillColor=#faf9fd;strokeColor=#b4a6cc;fontColor=#49336b;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="140" width="300" height="660" as="geometry"/></mxCell>
        <mxCell id="dbt-lane" value="WINTAP-PYUTIL • DBT / DUCKDB" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#e7f0e5;swimlaneFillColor=#f8fbf7;strokeColor=#9bb597;fontColor=#24542a;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1320" y="140" width="565" height="660" as="geometry"/></mxCell>
        <mxCell id="output-lane" value="LOCAL OUTPUT" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#e8eef6;swimlaneFillColor=#f8fafc;strokeColor=#a8b8cc;fontColor=#172b4d;fontSize=16;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1895" y="140" width="240" height="660" as="geometry"/></mxCell>

        <mxCell id="wintap-local" value="&lt;b&gt;Wintap • Windows host&lt;/b&gt;&lt;br&gt;Windows sensors → ETL / Parquet&lt;br&gt;&lt;br&gt;Writes event files to the&lt;br&gt;&lt;b&gt;Raw Event Store&lt;/b&gt; layout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4c78a8;fontColor=#173b65;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="45" y="250" width="220" height="155" as="geometry"/></mxCell>
        <mxCell id="lintap-local" value="&lt;b&gt;Lintap / TeleTap • Linux host&lt;/b&gt;&lt;br&gt;eBPF sensors → ETL / Parquet&lt;br&gt;&lt;br&gt;Writes event files to the&lt;br&gt;&lt;b&gt;Raw Event Store&lt;/b&gt; layout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4c78a8;fontColor=#173b65;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="45" y="490" width="220" height="155" as="geometry"/></mxCell>

        <mxCell id="raw-s3" value="&lt;b&gt;RAW EVENT STORE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Canonical host event Parquet, delivered to the configured S3 destination. Source for compaction and the raw-side DBT input." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9f6;strokeColor=#9673a6;fontColor=#49336b;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="325" y="340" width="230" height="200" as="geometry"/></mxCell>
        <mxCell id="raw-upload-note" value="Failed uploads retain local files for retry. Successful delivery may remove the local copy." style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#645575;spacing=8;" vertex="1" parent="1"><mxGeometry x="320" y="575" width="240" height="80" as="geometry"/></mxCell>

        <mxCell id="compact-command" value="&lt;b&gt;Manual hourly CLI&lt;/b&gt;&lt;br&gt;Selected completed UTC hour(s) • schedules deferred&lt;br&gt;Separate compactor environment (DuckDB 2.0); DBT remains on its existing engine." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c49a28;fontColor=#644c0c;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="615" y="205" width="360" height="105" as="geometry"/></mxCell>
        <mxCell id="entity-phase" value="&lt;b&gt;OPTIONAL 1 • DURABLE PROCESS ENTITIES&lt;/b&gt;&lt;br&gt;Before raw merge/deletion: reduce selected process evidence into complete per-host snapshots; validate and publish changed snapshots. Replay can also read compacted process history.&lt;br&gt;&lt;br&gt;Entity failure blocks source deletion in combined mode. Opt-in; no production schedule/cutover." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#49336b;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="615" y="335" width="360" height="175" as="geometry"/></mxCell>
        <mxCell id="raw-compaction" value="&lt;b&gt;2 • ROW-PRESERVING EVENT COMPACTION&lt;/b&gt;&lt;br&gt;Group by event + exact day/hour/(protocol) leaf. Name-aligned UNION ALL; preserve rows/fields; validate source/output row totals (`compact` / `verify`).&lt;br&gt;&lt;br&gt;Existing destination hour skips. Retain source by default; optional validated prefix deletion after grace." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c49a28;fontColor=#644c0c;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="615" y="550" width="360" height="205" as="geometry"/></mxCell>

        <mxCell id="compacted-s3" value="&lt;b&gt;COMPACTED EVENT STORE&lt;/b&gt;&lt;br&gt;&lt;br&gt;Hourly merged event Parquet. DBT reads it alongside remaining raw partitions." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9f6;strokeColor=#9673a6;fontColor=#49336b;fontSize=14;spacing=11;" vertex="1" parent="1"><mxGeometry x="1035" y="245" width="250" height="145" as="geometry"/></mxCell>
        <mxCell id="entity-s3" value="&lt;b&gt;PROCESS ENTITY SNAPSHOT STORE&lt;/b&gt;&lt;br&gt;&lt;br&gt;One complete snapshot per host; retains long-lived and exited context (no TTL/GC). Separate from event roots." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#49336b;fontSize=14;spacing=11;" vertex="1" parent="1"><mxGeometry x="1035" y="420" width="250" height="165" as="geometry"/></mxCell>
        <mxCell id="metrics-s3" value="&lt;b&gt;PROCESSING CHECKPOINT STORE&lt;/b&gt;&lt;br&gt;Entity mode: hourly coverage / policy / run evidence.&lt;br&gt;Init/replay: after entities.&lt;br&gt;Combined: after raw processing.&lt;br&gt;Not a migration receipt." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#49336b;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="1035" y="615" width="250" height="155" as="geometry"/></mxCell>

        <mxCell id="dbt-build" value="&lt;b&gt;make dbt-build&lt;/b&gt;&lt;br&gt;Config + source preflight → DBT build&lt;br&gt;&lt;br&gt;DBT reads Raw Event Store + Compacted Event Store; optional entity enrichment is separate." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#548b50;fontColor=#24542a;fontSize=14;spacing=10;" vertex="1" parent="1"><mxGeometry x="1345" y="195" width="515" height="85" as="geometry"/></mxCell>
        <mxCell id="union-input" value="&lt;b&gt;EVENT HISTORY INPUT • NAME-ALIGNED UNION ALL&lt;/b&gt;&lt;br&gt;Read Raw Event Store + Compacted Event Store. Migrated compacted partitions plus remaining raw partitions form retained history.&lt;br&gt;&lt;b&gt;No overlap suppression/dedup:&lt;/b&gt; if both stores contain a copy, both contribute rows." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9f6;strokeColor=#9673a6;fontColor=#49336b;fontSize=13;spacing=9;" vertex="1" parent="1"><mxGeometry x="1345" y="300" width="515" height="125" as="geometry"/></mxCell>
        <mxCell id="bronze" value="&lt;b&gt;BRONZE&lt;/b&gt;&lt;br&gt;Raw staging from both Parquet roots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c49a28;fontColor=#644c0c;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="1345" y="465" width="145" height="110" as="geometry"/></mxCell>
        <mxCell id="silver" value="&lt;b&gt;SILVER&lt;/b&gt;&lt;br&gt;Normalized details; enrich process/parent context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4c78a8;fontColor=#173b65;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="1525" y="465" width="150" height="110" as="geometry"/></mxCell>
        <mxCell id="gold" value="&lt;b&gt;GOLD&lt;/b&gt;&lt;br&gt;Analyst-facing summaries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#6b2825;fontSize=14;spacing=9;" vertex="1" parent="1"><mxGeometry x="1710" y="465" width="145" height="110" as="geometry"/></mxCell>
        <mxCell id="entity-models" value="&lt;b&gt;SEPARATE PROCESS CONTEXT RELATIONS&lt;/b&gt;&lt;br&gt;Opt-in Process Entity Snapshot Store (+ configured hosts/namespace) → stg_process_entities → process_entities / process_context / process_path. Supplies durable ancestry to selected-window process models; historical snapshots do not become raw lifecycle events or inflate window counts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8f7;strokeColor=#9673a6;fontColor=#49336b;fontSize=13;spacing=10;" vertex="1" parent="1"><mxGeometry x="1345" y="625" width="510" height="125" as="geometry"/></mxCell>

        <mxCell id="duckdb" value="&lt;b&gt;LOCAL DUCKDB&lt;/b&gt;&lt;br&gt;WINTAP_DBT_DATABASE&lt;br&gt;&lt;br&gt;Built bronze / silver / gold / process-context relations feed SQL and downstream analysis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172b4d;fontSize=14;spacing=12;" vertex="1" parent="1"><mxGeometry x="1920" y="365" width="190" height="190" as="geometry"/></mxCell>
        <mxCell id="dbt-output-note" value="DBT materializes to local DuckDB. Parquet export of bronze/silver/gold is not implemented." style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#475569;spacing=8;" vertex="1" parent="1"><mxGeometry x="1910" y="590" width="210" height="90" as="geometry"/></mxCell>

        <mxCell id="ew" value="upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=3;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.32;" edge="1" parent="1" source="wintap-local" target="raw-s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="el" value="upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=3;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="lintap-local" target="raw-s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="290" y="567"/><mxPoint x="290" y="490"/></Array></mxGeometry></mxCell>
        <mxCell id="raw-to-entity" value="process" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.35;" edge="1" parent="1" source="raw-s3" target="entity-phase"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="400"/><mxPoint x="580" y="396"/></Array></mxGeometry></mxCell>
        <mxCell id="raw-to-compact" value="event files" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="raw-s3" target="raw-compaction"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="480"/><mxPoint x="580" y="652"/></Array></mxGeometry></mxCell>
        <mxCell id="command-entity" value="optional phase" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;dashed=1;strokeWidth=2;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="compact-command" target="entity-phase"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="command-raw" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#c49a28;dashed=1;strokeWidth=2;exitX=0;exitY=0.5;entryX=0;entryY=0.1;" edge="1" parent="1" source="compact-command" target="raw-compaction"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="600" y="258"/><mxPoint x="600" y="570"/></Array></mxGeometry></mxCell>
        <mxCell id="entity-then-raw" value="verified first in combined mode" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="entity-phase" target="raw-compaction"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="compact-to-s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#c49a28;strokeWidth=3;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.65;" edge="1" parent="1" source="raw-compaction" target="compacted-s3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="610"/><mxPoint x="1000" y="339"/></Array></mxGeometry></mxCell>
        <mxCell id="entity-to-s3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=3;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="entity-phase" target="entity-s3"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="raw-to-union" value="raw_sensor globs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4c78a8;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.12;entryX=0;entryY=0.25;" edge="1" parent="1" source="raw-s3" target="union-input"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="580" y="364"/><mxPoint x="580" y="190"/><mxPoint x="1310" y="190"/><mxPoint x="1310" y="331"/></Array></mxGeometry></mxCell>
        <mxCell id="compacted-to-union" value="events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#c49a28;strokeWidth=3;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="compacted-s3" target="union-input"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="entity-to-models" value="separate entity root" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=3;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.65;entryX=0;entryY=0.5;" edge="1" parent="1" source="entity-s3" target="entity-models"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="raw-to-metrics" value="then verify" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.8;entryX=0;entryY=0.65;" edge="1" parent="1" source="raw-compaction" target="metrics-s3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="metrics-to-models" value="coverage + QA" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=2;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.6;entryX=0;entryY=0.8;" edge="1" parent="1" source="metrics-s3" target="entity-models"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="build-union" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#548b50;dashed=1;strokeWidth=2;" edge="1" parent="1" source="dbt-build" target="union-input"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="union-bronze" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#c49a28;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="union-input" target="bronze"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1417" y="445"/></Array></mxGeometry></mxCell>
        <mxCell id="bronze-silver" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#c49a28;strokeWidth=2;" edge="1" parent="1" source="bronze" target="silver"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="entity-enrich" value="context enrichment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;dashed=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.65;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="entity-models" target="silver"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1677" y="605"/><mxPoint x="1600" y="605"/></Array></mxGeometry></mxCell>
        <mxCell id="silver-gold" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4c78a8;strokeWidth=2;" edge="1" parent="1" source="silver" target="gold"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="gold-db" value="built" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;strokeWidth=2;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gold" target="duckdb"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="validation-title" value="CORE VALIDATION • PYUTIL MAKE TARGETS" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="30" y="825" width="2070" height="35" as="geometry"/></mxCell>
        <mxCell id="preflight" value="&lt;b&gt;1 • Confirm effective inputs&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;make print-dbt-config&lt;/b&gt; — effective roots/type/window; offline, no credentials.&lt;br&gt;&lt;br&gt;&lt;b&gt;make dbt-check-config&lt;/b&gt; — local/S3 roots, partition dates and local DB output.&lt;br&gt;&lt;br&gt;&lt;b&gt;make dbt-check-source&lt;/b&gt; — probes supported raw + compacted inputs; reads one matching Parquet schema, not every file." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#334155;fontSize=14;spacing=11;" vertex="1" parent="1"><mxGeometry x="30" y="870" width="650" height="205" as="geometry"/></mxCell>
        <mxCell id="buildtest" value="&lt;b&gt;2 • Build and test models&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;make dbt-build&lt;/b&gt; — config + source checks, then builds the DBT graph.&lt;br&gt;&lt;br&gt;&lt;b&gt;make dbt-test&lt;/b&gt; — configured model/data tests.&lt;br&gt;&lt;br&gt;Entity mode additionally checks expected snapshots and selected process-hour checkpoints. Missing hourly coverage fails preflight." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#334155;fontSize=14;spacing=11;" vertex="1" parent="1"><mxGeometry x="700" y="870" width="620" height="205" as="geometry"/></mxCell>
        <mxCell id="postqa" value="&lt;b&gt;3 • Inspect built data&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;make dbt-check-output&lt;/b&gt; — requires readable local DB; prerequisite for QA dashboards.&lt;br&gt;&lt;br&gt;&lt;b&gt;make qa-pid-hash&lt;/b&gt; — process-key orphan/relationship SQL checks.&lt;br&gt;&lt;br&gt;&lt;b&gt;make qa-dashboard / make qa-pidstat&lt;/b&gt; — Marimo DBT overview / pidstat QA. Raw-backed views still need source access." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#334155;fontSize=14;spacing=11;" vertex="1" parent="1"><mxGeometry x="1340" y="870" width="795" height="205" as="geometry"/></mxCell>
        <mxCell id="storage-glossary" value="&lt;b&gt;STORAGE GLOSSARY • FULL PATHS&lt;/b&gt;&lt;br&gt;&lt;b&gt;Raw Event Store&lt;/b&gt; — &amp;lt;dataset&amp;gt;/raw_sensor/&amp;lt;event&amp;gt;/dayPK=YYYYMMDD/hourPK=HH[/protoPK=...]/&amp;lt;file&amp;gt;.parquet&lt;br&gt;&lt;b&gt;Compacted Event Store&lt;/b&gt; — &amp;lt;dataset&amp;gt;/compacted/&amp;lt;event&amp;gt;/dayPK=YYYYMMDD/hourPK=HH[/protoPK=...]/&amp;lt;merged&amp;gt;.parquet&lt;br&gt;&lt;b&gt;Process Entity Snapshot Store&lt;/b&gt; — &amp;lt;entity-root&amp;gt;/hostPK=&amp;lt;sha256(trimmed uppercase hostname)&amp;gt;/entities.parquet&lt;br&gt;&lt;b&gt;Processing Checkpoint Store&lt;/b&gt; — &amp;lt;metrics-root&amp;gt;/dayPK=YYYYMMDD/hourPK=HH/metrics.parquet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#334155;fontSize=13;spacing=12;" vertex="1" parent="1"><mxGeometry x="30" y="1095" width="2105" height="145" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
