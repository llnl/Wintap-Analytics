<mxfile host="app.diagrams.net" modified="2026-11-11T00:00:00.000Z" agent="Wintap Ecosystem Wiki" version="24.7.17" type="device">
  <diagram id="wintap-etl-data-flow" name="Wintap/Lintap → S3 → PyUtil DBT">
    <mxGraphModel dx="1920" dy="1260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1260" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Wintap / Lintap telemetry → S3 → Wintap-PyUtil ETL" style="text;html=1;align=left;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1800" height="45" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Host-local raw Parquet is delivered to S3; PyUtil reads local or S3 raw_sensor inputs and builds bronze → silver → gold relations in a local DuckDB database." style="text;html=1;align=left;fontSize=16;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="40" y="78" width="1830" height="35" as="geometry"/></mxCell>

        <mxCell id="hosts" value="COLLECTION HOSTS • LOCAL DISK" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#e8eef6;swimlaneFillColor=#f8fafc;strokeColor=#a8b8cc;fontColor=#172b4d;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="145" width="380" height="580" as="geometry"/></mxCell>
        <mxCell id="s3" value="S3 / S3-COMPATIBLE OBJECT STORE" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#ede9f6;swimlaneFillColor=#faf9fd;strokeColor=#b4a6cc;fontColor=#49336b;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="435" y="145" width="330" height="580" as="geometry"/></mxCell>
        <mxCell id="pyutil" value="WINTAP-PYUTIL • DBT / DUCKDB" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#e7f0e5;swimlaneFillColor=#f8fbf7;strokeColor=#9bb597;fontColor=#24542a;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="790" y="145" width="850" height="580" as="geometry"/></mxCell>
        <mxCell id="analysis" value="ANALYSIS" style="swimlane;html=1;startSize=42;horizontal=1;rounded=1;arcSize=8;fillColor=#e8eef6;swimlaneFillColor=#f8fafc;strokeColor=#a8b8cc;fontColor=#172b4d;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1665" y="145" width="225" height="580" as="geometry"/></mxCell>

        <mxCell id="wintap-local" value="&lt;b&gt;Wintap • Windows host&lt;/b&gt;&lt;br&gt;Windows sensors → ETL / Parquet&lt;br&gt;&lt;br&gt;&lt;b&gt;Local data root&lt;/b&gt;&lt;br&gt;raw_sensor/&amp;lt;event&amp;gt;/dayPK=/hourPK=/*.parquet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4c78a8;fontColor=#173b65;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="320" height="160" as="geometry"/></mxCell>
        <mxCell id="lintap-local" value="&lt;b&gt;Lintap / TeleTap • Linux host&lt;/b&gt;&lt;br&gt;eBPF sensors → ETL / Parquet&lt;br&gt;&lt;br&gt;&lt;b&gt;Local data root&lt;/b&gt;&lt;br&gt;raw_sensor/&amp;lt;event&amp;gt;/dayPK=/hourPK=/*.parquet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4c78a8;fontColor=#173b65;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="60" y="465" width="320" height="160" as="geometry"/></mxCell>

        <mxCell id="s3-raw" value="&lt;b&gt;Delivered raw_sensor dataset&lt;/b&gt;&lt;br&gt;&lt;br&gt;Parquet objects, partitioned by event and day/hour&lt;br&gt;&lt;br&gt;S3 key layout mirrors raw_sensor/&lt;br&gt;&lt;br&gt;Upload requires the host's enabled adapter and destination configuration." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9f6;strokeColor=#9673a6;fontColor=#49336b;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="465" y="285" width="270" height="245" as="geometry"/></mxCell>
        <mxCell id="s3-note" value="Local files are retried after total upload failure; successful delivery may remove them from host disk." style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#645575;spacing=8;" vertex="1" parent="1"><mxGeometry x="455" y="565" width="290" height="90" as="geometry"/></mxCell>

        <mxCell id="input-config" value="&lt;b&gt;Raw input + run window&lt;/b&gt;&lt;br&gt;WINTAP_DBT_RAW_SENSOR_DATASET&lt;br&gt;local dataset root or s3://bucket/prefix&lt;br&gt;day/hour partition window&lt;br&gt;&lt;br&gt;S3 input can be read directly; DuckDB output stays local." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172b4d;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="820" y="225" width="270" height="175" as="geometry"/></mxCell>
        <mxCell id="build-command" value="&lt;b&gt;Run from Wintap-PyUtil&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot;&gt;make dbt-build&lt;/font&gt;&lt;br&gt;&lt;br&gt;dbt-check-config → dbt-check-source → dbt build&lt;br&gt;Source probe checks access + one matching Parquet schema; it is not a full-file scan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#548b50;fontColor=#24542a;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="1120" y="225" width="485" height="175" as="geometry"/></mxCell>

        <mxCell id="bronze" value="&lt;b&gt;BRONZE&lt;/b&gt;&lt;br&gt;Raw-source staging&lt;br&gt;&lt;br&gt;Scan raw Parquet through shared DBT macros; handle optional sources and source-schema drift." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#c49a28;fontColor=#644c0c;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="815" y="475" width="235" height="155" as="geometry"/></mxCell>
        <mxCell id="silver" value="&lt;b&gt;SILVER&lt;/b&gt;&lt;br&gt;Normalized detail&lt;br&gt;&lt;br&gt;Typed, process-centric entities and event details; normalize fields and relationships." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#4c78a8;fontColor=#173b65;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1095" y="475" width="235" height="155" as="geometry"/></mxCell>
        <mxCell id="gold" value="&lt;b&gt;GOLD&lt;/b&gt;&lt;br&gt;Analyst-facing summaries&lt;br&gt;&lt;br&gt;Process, file, network and other family summaries built from silver models." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#6b2825;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1375" y="475" width="235" height="155" as="geometry"/></mxCell>
        <mxCell id="db-note" value="Build materializes DBT relations in the configured local DuckDB file (WINTAP_DBT_DATABASE). Parquet export is not implemented." style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#475569;spacing=8;" vertex="1" parent="1"><mxGeometry x="835" y="650" width="760" height="50" as="geometry"/></mxCell>

        <mxCell id="duckdb" value="&lt;b&gt;DuckDB database&lt;/b&gt;&lt;br&gt;bronze / silver / gold relations&lt;br&gt;&lt;br&gt;SQL • notebooks • downstream analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172b4d;fontSize=16;spacing=14;" vertex="1" parent="1"><mxGeometry x="1690" y="335" width="175" height="180" as="geometry"/></mxCell>
        <mxCell id="analysis-note" value="QA dashboards and analyst workflows consume the built local database. Raw-backed views still need their configured local/S3 input available." style="text;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#475569;spacing=8;" vertex="1" parent="1"><mxGeometry x="1680" y="550" width="195" height="115" as="geometry"/></mxCell>

        <mxCell id="ew" value="upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=3;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.28;" edge="1" parent="1" source="wintap-local" target="s3-raw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="330"/><mxPoint x="410" y="354"/></Array></mxGeometry></mxCell>
        <mxCell id="el" value="upload" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=3;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.78;" edge="1" parent="1" source="lintap-local" target="s3-raw"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="410" y="545"/><mxPoint x="410" y="475"/></Array></mxGeometry></mxCell>
        <mxCell id="es3input" value="local path or direct S3 read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#9673a6;strokeWidth=3;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3-raw" target="input-config"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="einputbuild" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#64748b;dashed=1;strokeWidth=2;" edge="1" parent="1" source="input-config" target="build-command"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ebuildbronze" value="build graph" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#548b50;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="build-command" target="bronze"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1150" y="435"/><mxPoint x="932" y="435"/></Array></mxGeometry></mxCell>
        <mxCell id="ebs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#c49a28;strokeWidth=2;" edge="1" parent="1" source="bronze" target="silver"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="esg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#4c78a8;strokeWidth=2;" edge="1" parent="1" source="silver" target="gold"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="egdb" value="materialize" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;strokeWidth=2;fontSize=13;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="gold" target="duckdb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1645" y="552"/><mxPoint x="1645" y="425"/></Array></mxGeometry></mxCell>

        <mxCell id="validation-title" value="CORE DATA VALIDATION • PYUTIL MAKE TARGETS" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontStyle=1;fontColor=#172b4d;" vertex="1" parent="1"><mxGeometry x="40" y="765" width="1840" height="35" as="geometry"/></mxCell>
        <mxCell id="preflight" value="&lt;b&gt;1 • Confirm effective inputs&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;make print-dbt-config&lt;/b&gt;&lt;br&gt;Offline checks + effective roots/type/window (no credentials).&lt;br&gt;&lt;br&gt;&lt;b&gt;make dbt-check-config&lt;/b&gt;&lt;br&gt;Checks input URI/path, dates/window and writable local DB output." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#334155;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="815" width="570" height="190" as="geometry"/></mxCell>
        <mxCell id="buildtest" value="&lt;b&gt;2 • Check source and model graph&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;make dbt-check-source&lt;/b&gt;&lt;br&gt;Lists supported event inputs and reads one matching Parquet schema; not an all-file integrity scan.&lt;br&gt;&lt;br&gt;&lt;b&gt;make dbt-build&lt;/b&gt;&lt;br&gt;Runs config + source checks, then builds DBT models.&lt;br&gt;&lt;br&gt;&lt;b&gt;make dbt-test&lt;/b&gt;&lt;br&gt;Runs configured DBT data/schema tests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#334155;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="630" y="815" width="630" height="190" as="geometry"/></mxCell>
        <mxCell id="postqa" value="&lt;b&gt;3 • Inspect built data&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;make dbt-check-output&lt;/b&gt;&lt;br&gt;Output-path gate used by the dashboard targets.&lt;br&gt;&lt;br&gt;&lt;b&gt;make qa-pid-hash&lt;/b&gt;&lt;br&gt;Runs pid_hash orphan/relationship SQL checks.&lt;br&gt;&lt;br&gt;&lt;b&gt;make qa-dashboard / make qa-pidstat&lt;/b&gt;&lt;br&gt;Launches PyUtil Marimo DBT overview / pidstat QA. Raw-backed views still need source access." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#334155;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="1280" y="815" width="600" height="190" as="geometry"/></mxCell>
        <mxCell id="important" value="&lt;b&gt;Important boundary&lt;/b&gt;  Host sensors create and upload raw Parquet; PyUtil owns canonical DBT transforms. Bronze → silver → gold is a logical model progression in DuckDB, not a set of S3-published Parquet layers. `dbt-check-source` is a bounded access/schema probe; successful preflight does not certify every file or row." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#644c0c;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="1035" width="1840" height="100" as="geometry"/></mxCell>
        <mxCell id="footer" value="Wintap owns Windows collection; Wintap's Linux TeleTap path underpins Lintap deployments; Wintap-PyUtil owns canonical DBT; Wintap-Analytics hosts this wiki and analysis context." style="text;html=1;align=left;fontSize=13;fontColor=#64748b;" vertex="1" parent="1"><mxGeometry x="40" y="1160" width="1840" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
